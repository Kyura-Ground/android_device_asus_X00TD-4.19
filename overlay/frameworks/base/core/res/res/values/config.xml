<!--
╔══════════════════════════════════════════════════════════════════════════╗
║  crDroid Android 16 — Device overlay                                   ║
║  Устройство: ASUS Zenfone Max Pro M1                                   ║
║  Модель: X00TD                                                         ║
║  Базовый overlay: common                                               ║
║                                                                          ║
║  Назначение:                                                             ║
║  - переопределение только тех ресурсов, которые отличаются от common;   ║
║  - автояркость и калибровка яркости общие с X01BD: до 420 нит;          ║
║  - универсальная работа на X00TD с 3 / 4 / 6 ГБ ОЗУ.                    ║
╚══════════════════════════════════════════════════════════════════════════╝
-->

<resources>

    <!-- Vibrator pattern for feedback about a long screen/key press -->
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>50</item>
        <item>60</item>
        <item>61</item>
    </integer-array>

    <!-- Vibrator pattern for feedback about touching a virtual key -->
    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>100</item>
        <item>20</item>
        <item>30</item>
    </integer-array>

    <!-- Vibrator pattern for a very short but reliable vibration for soft keyboard tap -->
    <integer-array name="config_keyboardTapVibePattern">
        <item>40</item>
    </integer-array>

    <!-- Sustained performance mode не поддерживается -->
    <bool name="config_sustainedPerformanceModeSupported">false</bool>

    <!-- Скругления экрана -->
    <bool name="config_supportsRoundedCornersOnWindows">false</bool>

</resources>
